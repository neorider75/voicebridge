[Unit]
Description=VoiceBridge FastAPI service
After=network.target

[Service]
Type=simple
User=voicebridge
Group=voicebridge
WorkingDirectory=/var/voicebridge/app/Site/backend
Environment="PATH=/var/voicebridge/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VB_DATA_DIR=/var/voicebridge/data"
Environment="VB_FRONTEND_DIR=/var/voicebridge/app/Site/frontend"
Environment="HF_HOME=/var/voicebridge/data/models/hf-cache"
Environment="HUGGINGFACE_HUB_CACHE=/var/voicebridge/data/models/hf-cache/hub"
# Coqui TTS (XTTS-v2) cache son modèle dans TTS_HOME (par défaut ~/.local/share/tts)
# qui n'est pas inscriptible pour le service voicebridge sous ProtectSystem=strict.
Environment="TTS_HOME=/var/voicebridge/data/models/tts-cache"
# Caches inscriptibles (le venv est en lecture seule sous ProtectSystem=strict).
# Sans NUMBA_CACHE_DIR, librosa @jit(cache=True) crashe au boot de NeuTTS.
Environment="NUMBA_CACHE_DIR=/var/voicebridge/data/cache/numba"
Environment="XDG_CACHE_HOME=/var/voicebridge/data/cache"
Environment="XDG_DATA_HOME=/var/voicebridge/data/cache/xdg-data"
Environment="XDG_CONFIG_HOME=/var/voicebridge/data/cache/xdg-config"
Environment="MPLCONFIGDIR=/var/voicebridge/data/cache/matplotlib"
# HOME redirigé : certaines libs ignorent XDG_* et écrivent direct dans
# ~/.local/.. sans passer par XDG. Un HOME pointant vers data/cache permet
# de capter ces écritures aussi.
Environment="HOME=/var/voicebridge/data/cache/home"
# Threading PyTorch / NumPy : par défaut PyTorch utilise toutes les cores
# disponibles, mais BLAS (OpenBLAS, MKL) peut prendre 1 thread par défaut sur
# certains setups → goulot fp32. On force tout à 4 (= nproc du VPS).
Environment="OMP_NUM_THREADS=4"
Environment="MKL_NUM_THREADS=4"
Environment="OPENBLAS_NUM_THREADS=4"
Environment="NUMEXPR_NUM_THREADS=4"
Environment="TORCH_NUM_THREADS=4"
ExecStart=/var/voicebridge/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=10

# Durcissement
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/voicebridge/data

[Install]
WantedBy=multi-user.target
